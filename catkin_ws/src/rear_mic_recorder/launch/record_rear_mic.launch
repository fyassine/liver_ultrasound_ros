<?xml version="1.0"?>
<launch>
  <arg name="device" default="default"/>
  <arg name="sample_rate" default="44100"/>
  <arg name="channels" default="2"/>
  <arg name="sample_format" default="S16_LE"/>
  <arg name="duration" default="0"/>
  <arg name="output_dir" default="data"/>
  <arg name="filename_prefix" default="rear_mic"/>
  <arg name="filename" default=""/>

  <node pkg="rear_mic_recorder" type="rear_mic_recorder_node.py" name="rear_mic_recorder" output="screen">
    <param name="device" value="$(arg device)"/>
    <param name="sample_rate" value="$(arg sample_rate)"/>
    <param name="channels" value="$(arg channels)"/>
    <param name="sample_format" value="$(arg sample_format)"/>
    <param name="duration" value="$(arg duration)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="filename_prefix" value="$(arg filename_prefix)"/>
    <param name="filename" value="$(arg filename)"/>
  </node>
</launch>
